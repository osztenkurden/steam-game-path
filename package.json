{
	"name": "steam-game-path",
	"version": "4.0.0",
	"description": "Get installed Steam games and their library paths on Windows, Linux, and macOS with zero runtime dependencies.",
	"type": "module",
	"types": "dist/index.d.mts",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown tsc/index.ts --minify",
		"test": "node --test",
		"typecheck": "tsc",
		"prettier": "prettier --config .prettierrc --write **/*.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/osztenkurden/steam-game-path.git"
	},
	"author": "Hubert Walczak <hubertwalczak8@gmail.com> (https://hwalczak.com/)",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/osztenkurden/steam-game-path/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"homepage": "https://github.com/osztenkurden/steam-game-path#readme",
	"devDependencies": {
		"@types/node": "^22.20.3",
		"prettier": "^3.9.7",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
